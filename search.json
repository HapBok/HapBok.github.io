---
layout: null
permalink: /search.json
---
[
{% for post in site.posts %}
{% assign primary_category = post.categories | first %}
{% assign category = site.data.categories | where: 'key', primary_category | first %}
{
"title": {{ post.title | jsonify }},
"description": {{ post.description | default: '' | jsonify }},
"content": {{ post.content | markdownify | strip_html | normalize_whitespace | jsonify }},
"url": {{ post.url | relative_url | jsonify }},
"category": {{ primary_category | jsonify }},
"categoryTitle": {{ category.title | default: '기록' | jsonify }},
"categoryUrl": {{ category.url | default: '/notes/' | relative_url | jsonify }},
"tags": {{ post.tags | jsonify }},
"date": {{ post.date | date: '%Y-%m-%d' | jsonify }},
"platform": {{ post.platform | default: '' | jsonify }},
"field": {{ post.field | default: '' | jsonify }},
"difficulty": {{ post.difficulty | default: '' | jsonify }}
}{% unless forloop.last %},{% endunless %}
{% endfor %}
]
